# ============================================================
# NIZAMI ISLAMIC CENTER & NIZAMI EDUCATION
# Environment Variables Template
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Nizami Islamic Center"
NODE_ENV=development

# --- MongoDB ---
# Get from MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nizami?retryWrites=true&w=majority

# --- Authentication (NextAuth v5 / Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-super-secret-auth-secret-at-least-32-chars

# --- Cloudinary (File Storage) ---
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# --- Email (SMTP via Nodemailer) ---
# Works with Gmail App Password, Zoho, Mailgun SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM="Nizami Islamic Center <noreply@nizami.in>"


# --- Google Maps (optional, for branch map embeds) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- WhatsApp (click-to-chat, no API needed for V1) ---
# Default WhatsApp number for the center
NEXT_PUBLIC_WHATSAPP_NUMBER=+919876543210

